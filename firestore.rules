rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /spaces/{spaceId} {
      function isMember() {
        return exists(/databases/$(database)/documents/spaces/$(spaceId)/members/$(request.auth.uid));
      }
      // Bridges the Phase A model (memberUids array on the space doc) so an
      // already-created space keeps working until it's self-migrated to the
      // members subcollection on next login.
      function isLegacyMember() {
        return 'memberUids' in resource.data && request.auth.uid in resource.data.memberUids;
      }

      allow read: if request.auth != null && (isMember() || isLegacyMember());
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (isMember() || isLegacyMember());

      match /members/{memberId} {
        allow read: if request.auth != null && (isMember() || isLegacyMember());
        allow create: if request.auth != null && request.auth.uid == memberId && (
          get(/databases/$(database)/documents/spaces/$(spaceId)).data.ownerUid == request.auth.uid
          || isLegacyMember()
          || ('joinedViaInvite' in request.resource.data
              && get(/databases/$(database)/documents/spaces/$(spaceId)/invites/$(request.resource.data.joinedViaInvite)).data.active == true)
        );
        // Leaving (self) or removing a housemate (any current member) are both allowed.
        allow delete: if request.auth != null && (request.auth.uid == memberId || isMember() || isLegacyMember());
      }

      match /invites/{inviteId} {
        allow get: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.createdBy == request.auth.uid
          && (isMember() || isLegacyMember());
        allow update: if request.auth != null && (isMember() || isLegacyMember());
      }

      // Legacy Phase 1-5 collections (flat J/P expense-splitting model),
      // kept readable/writable in case any old data still references them.
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }
      match /settlements/{settlementId} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }
      match /budgets/{month} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }

      match /bills/{billId} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }

      match /chores/{choreId} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }

      match /budgetEntries/{entryId} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }

      match /todos/{todoId} {
        allow read, write: if request.auth != null && (isMember() || isLegacyMember());
      }
    }
  }
}
